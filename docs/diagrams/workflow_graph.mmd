config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	orchestrator(orchestrator)
	audit(audit)
	issue_review(issue_review)
	revision(revision)
	patch_review(patch_review)
	apply(apply)
	review(review)
