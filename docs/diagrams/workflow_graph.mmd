	apply --> review;
	audit -.-> issue_review;
	audit -. &nbsp;report&nbsp; .-> prepare_report;
	audit -.-> revision;
	issue_review -. &nbsp;report&nbsp; .-> prepare_report;
	issue_review -.-> revision;
	orchestrator -.-> audit;
	orchestrator -. &nbsp;human_approval&nbsp; .-> issue_review;
	orchestrator -. &nbsp;report&nbsp; .-> prepare_report;
	orchestrator -.-> revision;
	patch_review -.-> apply;
	patch_review -. &nbsp;report&nbsp; .-> prepare_report;
	prepare_report --> report;
	review -.-> orchestrator;
	review -. &nbsp;report&nbsp; .-> prepare_report;
	revision --> patch_review;
	report --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
