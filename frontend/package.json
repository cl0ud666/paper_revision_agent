{
  "name": "paper-revision-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --config playwright.ui.config.ts",
    "test:preview": "playwright test --config playwright.preview.config.ts",
    "format": "prettier --write src *.ts *.json index.html e2e",
    "format:check": "prettier --check src *.ts *.json index.html e2e",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.80.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fflate": "^0.8.2",
    "prettier": "3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
