# DeepSeek API Key（必填）
DEEPSEEK_API_KEY=sk-请替换成你自己的Key

# ---------- 以下都是可选项，不写就用默认值 ----------

# 模型
# PRA_MODEL=deepseek-chat
# PRA_BASE_URL=https://api.deepseek.com
# PRA_MAX_TOKENS=4096
# PRA_TIMEOUT=120

# Workflow
# PRA_MAX_ITERATIONS=3
# PRA_RECURSION_LIMIT=60
# PRA_AGENT_TIMEOUT=180
# Audit 之后是否先问“这些问题有没有要忽略的”（默认 1）
# PRA_ISSUE_GATE=1

# 审查范围：body（摘要+正文，默认）/ body+refs / all
# 封面、目录、承诺页、致谢默认不审
# PRA_AUDIT_SCOPE=body

# 审查精度
# PRA_AUDIT_MIN_SEVERITY=medium   # 默认丢掉 low（可改 low 放开）
# PRA_AUDIT_MAX_ISSUES=15         # 合并后的总问题数上限
# PRA_AUDIT_CHUNK_TOKENS=1500     # 每批送审的文本量
# PRA_AUDIT_MAX_CHUNKS=24

# 成本与延迟预算（超限自动降级，不会崩）
# PRA_BUDGET_RUN_TOKENS=400000
# PRA_BUDGET_TURN_TOKENS=150000
# PRA_BUDGET_RUN_SECONDS=1800
# PRA_BUDGET_CALLS_PER_AGENT=40

# 可靠性（重试 / 熔断）
# PRA_RETRY_MAX_ATTEMPTS=3
# PRA_RETRY_BASE_DELAY=1.0
# PRA_RETRY_MAX_DELAY=8.0
# PRA_CIRCUIT_THRESHOLD=4
# PRA_CIRCUIT_RECOVERY=90

# Context 治理预算（单位：估算 tokens）
# PRA_CTX_ORCHESTRATOR=2500
# PRA_CTX_AUDIT=3000
# PRA_CTX_REVISION=6000
# PRA_CTX_REVIEW=8000
# PRA_AUDIT_CHUNK_TOKENS=1500
# PRA_REVISION_MAX_TOKENS=6000

# 跨进程持久化（需要额外安装 langgraph-checkpoint-sqlite）
# 默认已开启：data/checkpoints/paper_agent.sqlite
# PRA_CHECKPOINT_DB=data/checkpoints/paper_agent.sqlite

# 服务层（可选，部署 Web 时用）
# PRA_HOST=127.0.0.1
# PRA_PORT=8000
# PRA_API_TOKEN=          # 填了就要求 Authorization: Bearer <token>
# PRA_MAX_CONCURRENT_RUNS=2
