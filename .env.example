# DeepSeek API Key（必填）
DEEPSEEK_API_KEY=sk-请替换成你自己的Key

# ---------- 以下都是可选项，不写就用默认值 ----------

# 模型
# PRA_MODEL=deepseek-chat
# PRA_BASE_URL=https://api.deepseek.com
# PRA_MAX_TOKENS=4096
# PRA_TIMEOUT=120

# Workflow
# PRA_MAX_ITERATIONS=3
# PRA_RECURSION_LIMIT=60
# PRA_AGENT_TIMEOUT=180
# 决策闸门：Audit 全部跑完后，只把“没有唯一答案、只能由你定”的矛盾
# （术语统一成哪种写法、两处数值以哪处为准）列成 a/b/c 问你（默认 1）。
# fix 和可执行的 advice 都生成补丁，在最终确认中选择；无法执行的事项保留人工处理原因。
# PRA_ISSUE_GATE=1
# 补丁闸门：Revision 提出补丁后是否让你逐条接受/拒绝（默认 0 = 不打断，直接应用）。
# 需要人拍板的事已经在决策闸门问过一次了，这里默认不再逐条勾一遍。
# PRA_PATCH_GATE=0
# 写入确认：写 Word 副本之前，把本次全部改动列成“问题 / 改为什么 / 原因”让你剔除（默认 1）
# PRA_FINAL_CONFIRM=1

# 审查范围：body（摘要+正文，默认）/ body+refs / all
# 封面、目录、承诺页、致谢默认不审
# PRA_AUDIT_SCOPE=body

# 审查精度
# PRA_AUDIT_MIN_SEVERITY=medium   # 默认丢掉 low（可改 low 放开）
# PRA_AUDIT_MAX_ISSUES=15         # 合并后的总问题数上限
# PRA_AUDIT_CHUNK_TOKENS=1500     # 每批送审的文本量
# PRA_AUDIT_MAX_CHUNKS=24
# PRA_AUDIT_NAME_CHECK=1          # 专名核验：单独判断专有名词写法本身对不对（阿里云 ESC → ECS）
# PRA_AUDIT_COMPARE_SENTENCES=40  # “正文数字 × 表格”这一组最多取多少句正文数字句（超出会打印出来）

# Audit 并发与全局一致性（分块之间没有依赖，可以并行跑）
# PRA_AUDIT_CONCURRENCY=6         # 并发度；1 = 退回串行。太大会撞 API 速率限制
# PRA_AUDIT_TARGETED=1            # 定向对照（主力）：摘要×结论、摘要承诺×各章产出、正文数字×表格
# PRA_AUDIT_TARGETED_TOKENS=0     # 定向对照的 Context 预算；0 = 不限（对照材料本来就很短）
# PRA_AUDIT_CROSS_CHECK=1         # 全部候选（分块 + 专名核验 + 定向对照）做一次全局对齐
# PRA_AUDIT_WHOLE_PAPER=1         # 整篇兜底核查（只查跨章节矛盾）
# PRA_AUDIT_WHOLE_PAPER_SMALL_DOC=20000 # 正文不超过它就每轮整篇送一次；超过则退化为“其它环节零发现才跑”
# PRA_AUDIT_WHOLE_PAPER_TOKENS=24000    # 整篇兜底的 Context 预算（它没有分块兜底，别设 0）
# PRA_AUDIT_CROSS_CHECK_TOKENS=0  # 跨批对齐的 Context 预算；0 = 不限（默认）

# 成本与延迟预算（超限自动降级，不会崩）
# PRA_BUDGET_RUN_TOKENS=400000
# PRA_BUDGET_TURN_TOKENS=150000
# PRA_BUDGET_RUN_SECONDS=1800
# PRA_BUDGET_CALLS_PER_AGENT=40

# 可靠性（重试 / 熔断）
# PRA_RETRY_MAX_ATTEMPTS=3
# PRA_RETRY_BASE_DELAY=1.0
# PRA_RETRY_MAX_DELAY=8.0
# PRA_CIRCUIT_THRESHOLD=4
# PRA_CIRCUIT_RECOVERY=90

# Context 治理预算（单位：估算 tokens）
# PRA_CTX_ORCHESTRATOR=2500
# PRA_CTX_AUDIT=3000
# PRA_CTX_REVISION=6000
# PRA_CTX_REVIEW=8000
# PRA_AUDIT_CHUNK_TOKENS=1500
# PRA_REVISION_MAX_TOKENS=6000

# 跨进程持久化（需要额外安装 langgraph-checkpoint-sqlite）
# 默认已开启：data/checkpoints/paper_agent.sqlite
# PRA_CHECKPOINT_DB=data/checkpoints/paper_agent.sqlite
# Production: PostgreSQL is required when backend=postgres (no memory fallback).
# Install requirements-web.txt, then run: python main.py --setup-checkpoint
# PRA_CHECKPOINT_BACKEND=postgres
# PRA_CHECKPOINT_URL=postgresql://paper_agent:password@localhost:5432/paper_agent
# PRA_CHECKPOINT_POOL_SIZE=5
# Local development: auto chooses PostgreSQL when PRA_CHECKPOINT_URL is set,
# otherwise SQLite. Tests may explicitly select memory or sqlite.

# 服务层（可选，部署 Web 时用）
# PRA_HOST=127.0.0.1
# PRA_PORT=8000
# PRA_API_TOKEN=          # 填了就要求 Authorization: Bearer <token>
# PRA_MAX_CONCURRENT_RUNS=2

# ---------- 交付物：把改动写回 Word 原文件 ----------
# 上传 .docx 时，改动会以 Word「修订痕迹」+「批注」写回一份副本
# （data/runs/<run_id>/revised_document.docx），原文件一个字都不动。
# 需要安装 lxml（pip install lxml，或 pip install python-docx 会一起装上）；
# 没装就自动退回只输出 Markdown，流程不会中断。
#
# PRA_DOCX_OUTPUT=1                 # 0 = 只输出 Markdown
# PRA_REDLINE_AUTHOR=论文修改助手    # Word 里显示的"谁改的/谁写的批注"
# PRA_REDLINE_COMMENTS=1            # 0 = 只留修订痕迹，不写批注
